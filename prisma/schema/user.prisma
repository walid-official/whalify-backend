model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  phone         String?      @unique
  image         String?
  role          UserRole     @default(CUSTOMER)
  provider      AuthProvider @default(LOCAL)
  providerId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  vendor        Vendor?
  addresses     Address[]
  orders        Order[]
  usedCoupons   CouponUsage[]

  @@index([providerId])
  @@map("users")
}
