model Vendor {
  id          String    @id @default(cuid())
  userId      String    @unique
  shopName    String
  shopLogo    String?
  address     String?
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  products    Product[]
  orders      Order[]
  coupons     Coupon[]

  @@index([userId])
  @@map("vendors")
}
